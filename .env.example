# ==============================
# Project / Compose
# ==============================
COMPOSE_PROJECT_NAME=lockscore

# ==============================
# Frontend Build-time Config
# ==============================
FRONTEND_API_BASE_URL=https://apilockscore.vkarma.net/api/v1
FRONTEND_SOCKET_URL=https://lockscore.vkarma.net

# ==============================
# Application Runtime
# ==============================
NODE_ENV=production
ALLOWED_ORIGINS=https://lockscore.vkarma.net
JWT_SECRET=replace-with-a-long-random-secret
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# ==============================
# Database (MongoDB Atlas)
# ==============================
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/password-strength-checker?retryWrites=true&w=majority
