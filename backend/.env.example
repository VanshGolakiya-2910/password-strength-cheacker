# Application
PORT=5000
NODE_ENV=production

# Security
JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=https://lockscore.vkarma.net

# Database
MONGODB_URI=mongodb://username:password@mongodb:27017/password-strength-checker?authSource=admin

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
