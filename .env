# ==============================
# Project / Compose
# ==============================
COMPOSE_PROJECT_NAME=lockscore

# ==============================
# Frontend Build-time Config
# ==============================
FRONTEND_API_BASE_URL=https://apilockscore.vkarma.net/api/v1
FRONTEND_SOCKET_URL=https://lockscore.vkarma.net

# ==============================
# Application Runtime
# ==============================
NODE_ENV=production
ALLOWED_ORIGINS=https://lockscore.vkarma.net,http://localhost:3006,http://localhost
JWT_SECRET=dev-secret-key-change-in-production-12345678901234567890
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# ==============================
# Database (MongoDB Atlas)
# ==============================
MONGODB_URI=mongodb://host.docker.internal:27017/password-strength-checker
